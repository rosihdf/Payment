{
  "name": "amrtech-payment-leads",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy:ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "build:production": "node scripts/assert-production-env.mjs && node scripts/copy-ocr-assets.mjs && tsc -b && vite build --mode production",
    "verify:ocr-build": "node scripts/verify-ocr-build-assets.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build:production && npm run deploy:cloudflare",
    "deploy:cloudflare": "wrangler deploy",
    "keepalive:test": "wrangler deploy --dry-run && curl -sS -X POST \"${KEEPALIVE_TEST_URL:-http://127.0.0.1:8787/__keepalive}\"",
    "smoke:production": "node scripts/smoke-production.mjs",
    "secretscan:dist": "node scripts/secretscan-dist.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@supabase/supabase-js": "^2.111.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.7.1",
    "tesseract.js": "^6.0.1",
    "vite-plugin-pwa": "^1.0.2",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "supabase": "^2.111.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  }
}
